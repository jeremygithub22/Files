{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch Web App",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net6.0/item-app.dll",
            "applicationUrl": "https://localhost:3001;http://localhost:3000",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}